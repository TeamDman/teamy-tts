#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Input {
    float values[];
} input_values;

layout(std430, binding = 1) readonly buffer Durations {
    float values[];
} durations;

layout(std430, binding = 2) writeonly buffer Output {
    float values[];
} output_values;

layout(push_constant) uniform Parameters {
    uint channels;
    uint token_count;
    uint frame_count;
} parameters;

void main() {
    uint output_index = gl_GlobalInvocationID.x;
    uint output_count = parameters.channels * parameters.frame_count;
    if (output_index >= output_count) {
        return;
    }

    uint channel = output_index / parameters.frame_count;
    uint frame = output_index % parameters.frame_count;
    uint source_token = 0u;
    uint cursor = 0u;
    bool found = false;
    for (uint token = 0u; token < parameters.token_count; ++token) {
        uint repeat_count = uint(max(durations.values[token] + 0.5, 0.0));
        if (frame < cursor + repeat_count) {
            source_token = token;
            found = true;
            break;
        }
        cursor += repeat_count;
    }

    if (!found) {
        output_values.values[output_index] = 0.0;
        return;
    }

    output_values.values[output_index] =
        input_values.values[channel * parameters.token_count + source_token];
}
