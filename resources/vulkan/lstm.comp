#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputWeights {
    float values[];
} input_weights;

layout(std430, binding = 1) readonly buffer HiddenWeights {
    float values[];
} hidden_weights;

layout(std430, binding = 2) readonly buffer Bias {
    float values[];
} bias;

layout(std430, binding = 3) readonly buffer Input {
    float values[];
} input_values;

layout(std430, binding = 4) writeonly buffer Output {
    float values[];
} output_values;

layout(push_constant) uniform Parameters {
    uint input_channels;
    uint hidden_channels;
    uint sequence_length;
    uint reverse;
} parameters;

const uint MAX_HIDDEN_CHANNELS = 512u;
shared float hidden_state[MAX_HIDDEN_CHANNELS];
shared float cell_state[MAX_HIDDEN_CHANNELS];
shared float next_hidden_state[MAX_HIDDEN_CHANNELS];
shared float next_cell_state[MAX_HIDDEN_CHANNELS];

float sigmoid(float value) {
    return 1.0 / (1.0 + exp(-value));
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    if (parameters.hidden_channels > MAX_HIDDEN_CHANNELS) {
        return;
    }

    for (uint hidden = lane; hidden < parameters.hidden_channels; hidden += 256u) {
        hidden_state[hidden] = 0.0;
        cell_state[hidden] = 0.0;
    }
    barrier();

    for (uint step = 0u; step < parameters.sequence_length; ++step) {
        uint time = parameters.reverse == 0u
            ? step
            : parameters.sequence_length - 1u - step;
        for (uint hidden = lane; hidden < parameters.hidden_channels; hidden += 256u) {
            float gates[4];
            for (uint gate = 0u; gate < 4u; ++gate) {
                uint input_weight_offset =
                    (gate * parameters.hidden_channels + hidden) * parameters.input_channels;
                uint hidden_weight_offset =
                    (gate * parameters.hidden_channels + hidden) * parameters.hidden_channels;
                float value = bias.values[gate * parameters.hidden_channels + hidden];
                for (uint input_index = 0u; input_index < parameters.input_channels; ++input_index) {
                    value += input_weights.values[input_weight_offset + input_index]
                        * input_values.values[time * parameters.input_channels + input_index];
                }
                for (uint previous = 0u; previous < parameters.hidden_channels; ++previous) {
                    value += hidden_weights.values[hidden_weight_offset + previous]
                        * hidden_state[previous];
                }
                gates[gate] = value;
            }

            float forget_value = sigmoid(gates[1]);
            float input_value = sigmoid(gates[0]);
            float output_value = sigmoid(gates[2]);
            float candidate_value = tanh(gates[3]);
            float next_cell = forget_value * cell_state[hidden]
                + input_value * candidate_value;
            next_cell_state[hidden] = next_cell;
            next_hidden_state[hidden] = output_value * tanh(next_cell);
        }
        barrier();
        for (uint hidden = lane; hidden < parameters.hidden_channels; hidden += 256u) {
            hidden_state[hidden] = next_hidden_state[hidden];
            cell_state[hidden] = next_cell_state[hidden];
            output_values.values[time * parameters.hidden_channels + hidden] =
                next_hidden_state[hidden];
        }
        barrier();
    }
}
