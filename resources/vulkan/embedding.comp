#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform EmbeddingParams {
    uint sequence_length;
    uint embedding_dimension;
} params;

layout(std430, binding = 0) readonly buffer EmbeddingWeights {
    float values[];
} weights;

layout(std430, binding = 1) readonly buffer TokenIds {
    uint values[];
} tokens;

layout(std430, binding = 2) writeonly buffer EmbeddingOutput {
    float values[];
} output_values;

void main() {
    uint linear_index = gl_GlobalInvocationID.x;
    uint output_count = params.sequence_length * params.embedding_dimension;
    if (linear_index >= output_count) {
        return;
    }

    uint token_index = linear_index / params.embedding_dimension;
    uint embedding_index = linear_index % params.embedding_dimension;
    uint weight_index = tokens.values[token_index] * params.embedding_dimension + embedding_index;
    output_values.values[linear_index] = weights.values[weight_index];
}
