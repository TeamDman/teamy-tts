#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint channels;
    uint input_length;
    uint output_length;
    uint kernel_size;
    uint stride;
    uint padding_left;
} parameters;

layout(std430, binding = 0) readonly buffer Input {
    float values[];
} input_values;

layout(std430, binding = 1) writeonly buffer Output {
    float values[];
} output_values;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint element_count = parameters.channels * parameters.output_length;
    if (index >= element_count) {
        return;
    }
    uint channel = index / parameters.output_length;
    uint output_position = index % parameters.output_length;
    float value = -3.402823466e+38;
    for (uint kernel_position = 0u; kernel_position < parameters.kernel_size; ++kernel_position) {
        int input_position = int(output_position * parameters.stride)
            + int(kernel_position) - int(parameters.padding_left);
        if (input_position >= 0 && uint(input_position) < parameters.input_length) {
            value = max(value, input_values.values[channel * parameters.input_length
                + uint(input_position)]);
        }
    }
    output_values.values[index] = value;
}
