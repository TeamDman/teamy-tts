#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint source_channels;
    uint sequence_length;
    uint destination_channel_offset;
} parameters;

layout(std430, binding = 0) readonly buffer Input {
    float values[];
} input_values;

layout(std430, binding = 1) buffer Output {
    float values[];
} output_values;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint element_count = parameters.source_channels * parameters.sequence_length;
    if (index >= element_count) {
        return;
    }
    uint channel = index / parameters.sequence_length;
    uint position = index % parameters.sequence_length;
    uint destination = (parameters.destination_channel_offset + channel)
        * parameters.sequence_length + position;
    output_values.values[destination] = input_values.values[index];
}
