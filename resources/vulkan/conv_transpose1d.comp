#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform ConvTranspose1dParams {
    uint input_channels;
    uint input_length;
    uint output_channels;
    uint output_length;
    uint kernel_size;
    uint stride;
    uint dilation;
    uint padding;
    uint padding_out;
    uint has_bias;
} params;

layout(std430, binding = 0) readonly buffer ConvTransposeWeights {
    float values[];
} weights;

layout(std430, binding = 1) readonly buffer ConvTransposeBias {
    float values[];
} bias;

layout(std430, binding = 2) readonly buffer ConvTransposeInput {
    float values[];
} input_values;

layout(std430, binding = 3) writeonly buffer ConvTransposeOutput {
    float values[];
} output_values;

void main() {
    uint linear_index = gl_GlobalInvocationID.x;
    uint output_count = params.output_channels * params.output_length;
    if (linear_index >= output_count) {
        return;
    }

    uint output_channel = linear_index / params.output_length;
    uint output_position = linear_index % params.output_length;
    float value = params.has_bias == 0u ? 0.0 : bias.values[output_channel];
    for (uint input_channel = 0u; input_channel < params.input_channels; ++input_channel) {
        for (uint kernel_position = 0u; kernel_position < params.kernel_size; ++kernel_position) {
            int numerator = int(output_position) + int(params.padding)
                - int(kernel_position * params.dilation);
            if (numerator < 0 || numerator % int(params.stride) != 0) {
                continue;
            }
            uint input_position = uint(numerator / int(params.stride));
            if (input_position >= params.input_length) {
                continue;
            }
            uint input_index = input_channel * params.input_length + input_position;
            uint weight_index = (input_channel * params.output_channels + output_channel)
                * params.kernel_size + kernel_position;
            value += input_values.values[input_index] * weights.values[weight_index];
        }
    }
    output_values.values[linear_index] = value;
}
