#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer MatrixA {
    float values[];
} matrix_a;

layout(std430, binding = 1) readonly buffer MatrixB {
    float values[];
} matrix_b;

layout(std430, binding = 2) writeonly buffer MatrixC {
    float values[];
} matrix_c;

void main() {
    const uint dimension = 16;
    uint row = gl_GlobalInvocationID.y;
    uint column = gl_GlobalInvocationID.x;
    if (row >= dimension || column >= dimension) {
        return;
    }

    float sum = 0.0;
    for (uint k = 0; k < dimension; ++k) {
        sum += matrix_a.values[row * dimension + k]
            * matrix_b.values[k * dimension + column];
    }
    matrix_c.values[row * dimension + column] = sum;
}
