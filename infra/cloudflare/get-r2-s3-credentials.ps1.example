<##
.SYNOPSIS
Loads R2 S3 credentials from a user-selected 1Password item.

Copy this file to get-r2-s3-credentials.ps1, set
TEAMY_TTS_CLOUDFLARE_OP_ITEM, and dot-source the copy.
#>

$itemReference = $env:TEAMY_TTS_CLOUDFLARE_OP_ITEM
if ([string]::IsNullOrWhiteSpace($itemReference)) {
    throw "Set TEAMY_TTS_CLOUDFLARE_OP_ITEM before loading R2 credentials."
}

$opCommand = Get-Command op -ErrorAction SilentlyContinue
if ($null -eq $opCommand) {
    throw "The 1Password CLI ('op') is not available on PATH."
}

function Read-OpField {
    param([Parameter(Mandatory)][string]$Field)

    $output = & $opCommand.Source read "$itemReference/$Field"
    if ($LASTEXITCODE -ne 0) {
        throw "1Password could not read the configured R2 credential field."
    }

    $value = ($output -join "`n").Trim()
    if ([string]::IsNullOrWhiteSpace($value)) {
        throw "1Password returned an empty R2 credential field."
    }

    return $value
}

$env:AWS_ACCESS_KEY_ID = Read-OpField "access key id"
$env:AWS_SECRET_ACCESS_KEY = Read-OpField "secret access key"

Write-Host "R2 S3 credentials loaded from 1Password for this PowerShell session."
